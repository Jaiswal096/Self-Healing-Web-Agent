{
  "manifest_version": 3,
  "name": "AutoHeal Agent",
  "version": "1.0.0",
  "description": "Monitor web pages and integrate with Self-Healing Web Agent.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "AutoHeal Agent"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ]
}
