# Self-Healing Web Agent — Environment Configuration
# Copy this file to .env and fill in your values

# ── Google Gemini API Key ──────────────────────────────────────────────────
# Required for vision-based self-healing (gemini-1.5-flash)
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Optional: Browser settings ─────────────────────────────────────────────
# Set to "false" to run browser in visible (headed) mode for debugging
HEADLESS=true

# Timeout for browser element waiting (milliseconds)
BROWSER_TIMEOUT_MS=15000

# ── Optional: Logging level ────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
