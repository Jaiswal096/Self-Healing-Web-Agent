{
  "manifest_version": 3,
  "name": "Self-Healing Web Agent Monitor",
  "version": "1.0.0",
  "description": "Monitor web pages and register tasks for the Self-Healing Web Agent.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
